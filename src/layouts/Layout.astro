---
interface Props {
  title?: string;
  description?: string;
}
const {
  title = "Clínica Esmera | Estética y Medicina Estética",
  description = "Centro de estética y medicina estética en Madrid. Tratamientos faciales, corporales, micropigmentación, aparatología avanzada y medicina estética.",
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <script
      src="https://link.msgsndr.com/js/external-tracking.js"
      data-tracking-id="tk_163224d8d7fc4ac8a5c890992aff6976"
    ></script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,200;0,300;0,400;0,500;0,600;0,700;1,200;1,300;1,400;1,500;1,600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <slot />

    <div class="chatbot-float">
      <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 64 64" fill="currentColor" class="chatbot-icon">
        <rect x="16" y="20" width="32" height="26" rx="6" ry="6"/>
        <rect x="22" y="28" width="6" height="6" rx="2" ry="2" fill="#fff"/>
        <rect x="36" y="28" width="6" height="6" rx="2" ry="2" fill="#fff"/>
        <rect x="26" y="37" width="12" height="3" rx="1.5" ry="1.5" fill="#fff"/>
        <rect x="29" y="12" width="6" height="8" rx="3" ry="3"/>
        <circle cx="32" cy="11" r="3"/>
        <rect x="8" y="28" width="5" height="10" rx="2.5" ry="2.5"/>
        <rect x="51" y="28" width="5" height="10" rx="2.5" ry="2.5"/>
      </svg>
      <div class="chatbot-text">
        <span class="chatbot-label">CHATBOT</span>
        <span class="chatbot-sub">Te ayudamos</span>
      </div>
    </div>

    <a
      href="https://wa.me/34661310256?text=Hola%2C%20me%20gustar%C3%ADa%20pedir%20informaci%C3%B3n"
      class="wa-float"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Contactar por WhatsApp"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/>
        <path d="M12 0C5.373 0 0 5.373 0 12c0 2.117.554 4.103 1.523 5.824L.057 23.882l6.233-1.635A11.945 11.945 0 0012 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 21.818a9.818 9.818 0 01-5.006-1.373l-.359-.214-3.7.971.989-3.614-.235-.372A9.818 9.818 0 1112 21.818z"/>
      </svg>
      <span>WhatsApp</span>
    </a>
  </body>
</html>

<style is:global>
  *, *::before, *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  :root {
    --gold: #D4AF37;
    --gold-warm: #C9960C;
    --gold-light: #F8DE5A;
    --gold-pale: #FDF0BC;
    --gold-tint: #FFFBEB;
    --gold-gradient: linear-gradient(
      135deg,
      #7D5A12 0%,
      #C9960C 18%,
      #D4AF37 35%,
      #F8DE5A 50%,
      #FFF8C0 56%,
      #D4AF37 68%,
      #C9960C 82%,
      #7D5A12 100%
    );
    --gold-gradient-h: linear-gradient(
      90deg,
      transparent 0%,
      #C9960C 25%,
      #F8DE5A 50%,
      #C9960C 75%,
      transparent 100%
    );
    --green: #19C771;
    --dark: #2C2C2C;
    --dark-rich: #242424;
    --ivory: #FAF9F5;
    --ivory-mid: #F5F2E9;
    --ivory-deep: #EDE9DC;
    --white: #FFFFFF;
    --stone: #8C8880;
    --stone-light: #B8B4AC;
    --text: #2C2C2C;
    --text-soft: #3D3A36;
    --text-muted: #625E58;

    --font-display: 'Montserrat', sans-serif;
    --font-serif: 'Montserrat', sans-serif;
    --font-body: 'Montserrat', sans-serif;

    --max-w: 1180px;
    --radius: 4px;
    --shadow-soft: 0 2px 20px rgba(44, 44, 44, 0.06);
    --shadow-mid: 0 8px 40px rgba(44, 44, 44, 0.09);
    --ease: cubic-bezier(0.25, 0.46, 0.45, 0.94);
    --t: 0.35s;
  }

  html {
    scroll-behavior: smooth;
    font-size: 16px;
  }

  body {
    font-family: var(--font-body);
    color: var(--text);
    background: var(--ivory);
    line-height: 1.7;
    overflow-x: hidden;
    -webkit-font-smoothing: antialiased;
    font-weight: 400;
  }

  h1, h2, h3, h4 {
    font-family: var(--font-display);
    line-height: 1.15;
    font-weight: 400;
  }

  a { color: inherit; text-decoration: none; }
  img { max-width: 100%; height: auto; display: block; }

  .container {
    max-width: var(--max-w);
    margin: 0 auto;
    padding: 0 32px;
  }

  /* ── Section header pattern ── */
  .eyebrow {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 20px;
  }
  .eyebrow::before {
    content: '';
    display: block;
    width: 32px;
    height: 1px;
    background: var(--gold-gradient-h);
    flex-shrink: 0;
  }
  .eyebrow span {
    font-family: var(--font-body);
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--gold-warm);
  }

  .sec-title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 3.2vw, 2.8rem);
    font-weight: 300;
    color: var(--dark);
    line-height: 1.18;
    margin-bottom: 18px;
    letter-spacing: -0.02em;
  }

  .sec-title em {
    font-style: italic;
    font-weight: 600;
    color: var(--dark);
  }

  .sec-lead {
    font-size: 1rem;
    color: var(--text-soft);
    line-height: 1.8;
    max-width: 520px;
    font-weight: 400;
  }

  /* ── Buttons ── */
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    cursor: pointer;
    border: none;
    transition: all var(--t) var(--ease);
    text-decoration: none;
    white-space: nowrap;
  }

  .btn-solid {
    background: var(--dark);
    color: var(--ivory);
    padding: 15px 36px;
    border-radius: var(--radius);
  }
  .btn-solid:hover {
    background: var(--gold-warm);
    color: var(--dark);
  }

  @keyframes gold-shimmer {
    0%   { background-position: 100% center; }
    100% { background-position: 0%   center; }
  }

  .btn-gold {
    background: linear-gradient(
      110deg,
      #D4AF37 0%, #E8C84A 18%, #F8DE5A 35%,
      #FFF8C0 50%, #F8DE5A 65%, #E8C84A 82%, #D4AF37 100%
    );
    background-size: 260% 100%;
    animation: gold-shimmer 4s ease-in-out infinite alternate;
    color: var(--dark);
    padding: 15px 36px;
    border-radius: var(--radius);
  }
  .btn-gold:hover {
    animation-play-state: paused;
    background-position: 40% center;
    box-shadow: 0 8px 36px rgba(180, 140, 20, 0.5);
  }

  .btn-ghost {
    background: transparent;
    color: var(--ivory);
    padding: 14px 34px;
    border-radius: var(--radius);
    border: 1px solid rgba(255,255,255,0.3);
  }
  .btn-ghost:hover {
    border-color: rgba(255,255,255,0.7);
    background: rgba(255,255,255,0.06);
  }

  .btn-ghost-dark {
    background: transparent;
    color: var(--dark);
    padding: 14px 34px;
    border-radius: var(--radius);
    border: 1px solid rgba(44,44,44,0.25);
  }
  .btn-ghost-dark:hover {
    background: var(--dark);
    color: var(--ivory);
    border-color: var(--dark);
  }

  /* ── Gold rule ornament ── */
  .gold-rule {
    display: flex;
    align-items: center;
    gap: 14px;
    color: var(--gold);
    font-size: 0.6rem;
    letter-spacing: 0.3em;
  }
  .gold-rule::before,
  .gold-rule::after {
    content: '';
    height: 1px;
    background: var(--gold-gradient-h);
    opacity: 0.7;
    flex: 1;
  }

  /* ── Chatbot floating button ── */
  .chatbot-float {
    position: fixed;
    bottom: 80px;
    right: 24px;
    z-index: 999;
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 12px;
    background: #fff;
    color: var(--dark);
    padding: 12px 18px;
    border-radius: 50px;
    box-shadow: 0 4px 20px rgba(0,0,0,0.22);
    cursor: default;
  }
  .chatbot-icon {
    flex-shrink: 0;
    opacity: 0.9;
  }
  .chatbot-text {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .chatbot-label {
    font-family: var(--font-body);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .chatbot-sub {
    font-family: var(--font-body);
    font-size: 0.65rem;
    font-weight: 300;
    letter-spacing: 0.06em;
    opacity: 0.7;
  }

  /* ── WhatsApp floating button ── */
  .wa-float {
    position: fixed;
    bottom: 24px;
    right: 24px;
    z-index: 999;
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 10px;
    background: #128C4A;
    color: #fff;
    padding: 13px 20px;
    border-radius: 50px;
    text-decoration: none;
    box-shadow: 0 4px 20px rgba(0,0,0,0.2);
    transition: background 0.25s ease, box-shadow 0.25s ease, transform 0.25s ease;
  }
  .wa-float:hover {
    background: #0f7a3e;
    box-shadow: 0 6px 28px rgba(0,0,0,0.28);
    transform: translateY(-2px);
  }
  .wa-float span {
    font-family: var(--font-body);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    writing-mode: unset;
    transform: none;
  }

  /* ── Gold gradient text utility ── */
  .gold-text {
    background: var(--gold-gradient);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: var(--gold);
  }
</style>
