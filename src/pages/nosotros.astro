---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import PageHero from '../components/PageHero.astro';
import Footer from '../components/Footer.astro';

const valores = [
  { n: "Rigor clínico", d: "Todos nuestros tratamientos tienen evidencia científica demostrada. No aplicamos ningún protocolo sin respaldo clínico verificado." },
  { n: "Personalización real", d: "No existe un protocolo único. Cada cliente recibe un diagnóstico individual y un plan de tratamiento diseñado exclusivamente para su caso." },
  { n: "Transparencia total", d: "Explicamos qué hacemos, por qué lo hacemos y qué puedes esperar. Sin promesas irreales, sin letra pequeña." },
  { n: "Resultados medibles", d: "Trabajamos con objetivos claros y hacemos seguimiento real de la evolución de cada cliente. Los resultados son la única métrica que nos importa." },
];

---

<Layout title="Nosotros · Clínica Esmera">
  <Navbar />
  <PageHero
    eyebrow="Quiénes somos"
    title="Clínica Esmera,"
    titleItalic="tu clínica de confianza"
    description="Más de una década dedicados a la excelencia estética en Madrid. Un equipo médico y estético que combina rigor científico con una atención verdaderamente personalizada."
    breadcrumb={[{ label: "Nosotros", href: "/nosotros" }]}
  />

  <!-- Historia & valores -->
  <section class="nos-section">
    <div class="container">

      <div class="nos-intro-text">
        <div class="eyebrow"><span>Nuestra historia</span></div>
        <h2 class="sec-title">Una clínica <em>diferente</em></h2>
        <p class="nos-body">Clínica Esmera nació de la convicción de que la estética y la medicina estética merecen el mismo rigor que cualquier otra especialidad médica. Llevamos más de 10 años en Madrid ofreciendo tratamientos de alto rendimiento a personas que buscan resultados reales, no promesas vacías.</p>
        <p class="nos-body">Nuestro nombre lo dice todo: esmerar. Dedicamos tiempo, conocimiento y atención a cada cliente porque sabemos que detrás de cada consulta hay una persona con objetivos propios, una historia particular y una confianza que no nos tomamos a la ligera.</p>
      </div>

    </div>
  </section>

  <!-- Valores -->
  <section class="valores-section">
    <div class="container">
      <div class="eyebrow"><span>Lo que nos define</span></div>
      <h2 class="sec-title">Nuestros <em>valores</em></h2>
      <div class="val-grid">
        {valores.map((v, i) => (
          <div class="val-card">
            <div class="vc-num">{String(i + 1).padStart(2, '0')}</div>
            <div class="vc-line"></div>
            <h3 class="vc-title">{v.n}</h3>
            <p class="vc-desc">{v.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Reseñas -->
  <section class="reviews-section">
    <div class="container">
      <div class="eyebrow"><span>Lo que dicen nuestras clientas</span></div>
      <h2 class="sec-title">Resultados <em>reales</em></h2>
      <div class="rev-grid">
        <div class="rev-card">
          <div class="rc-stars">★★★★★</div>
          <p class="rc-text">"Llevo dos años viniendo a Clínica Esmera y el cambio en mi piel es espectacular. El tratamiento de HIFU me lo recomendó la Dra. Morales y estoy encantada con los resultados. Totalmente profesional y sin agobios."</p>
          <div class="rc-author">
            <div class="rca-avatar">M</div>
            <div>
              <div class="rca-name">María G.</div>
              <div class="rca-tratamiento">HIFU Ultrafocal · Clienta desde 2022</div>
            </div>
          </div>
        </div>
        <div class="rev-card">
          <div class="rc-stars">★★★★★</div>
          <p class="rc-text">"Me hice el láser corporal completo y el resultado es exactamente lo que buscaba. El equipo es muy profesional, explican todo con detalle y te hacen sentir cómoda en todo momento. Sin duda volvería."</p>
          <div class="rc-author">
            <div class="rca-avatar">S</div>
            <div>
              <div class="rca-name">Sara P.</div>
              <div class="rca-tratamiento">Láser Depilatorio · Clienta desde 2023</div>
            </div>
          </div>
        </div>
        <div class="rev-card">
          <div class="rc-stars">★★★★★</div>
          <p class="rc-text">"Después de buscar mucho, di con Clínica Esmera para la micropigmentación de cejas. Carmen es una artista. El resultado es completamente natural, exactamente lo que quería. Repetiré sin dudarlo."</p>
          <div class="rc-author">
            <div class="rca-avatar">A</div>
            <div>
              <div class="rca-name">Ana R.</div>
              <div class="rca-tratamiento">Micropigmentación · Clienta desde 2024</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Contacto -->
  <section class="contacto-section" id="contacto">
    <div class="container">
      <div class="eyebrow"><span>Contacto</span></div>
      <h2 class="sec-title cont-title">Estamos <em>aquí para ti</em></h2>
      <div class="cont-datos">
        <div class="cd-item">
          <svg width="14" height="14" viewBox="0 0 14 14" fill="var(--gold)" opacity="0.7"><path d="M7 0C4.24 0 2 2.24 2 5c0 3.87 5 9 5 9s5-5.13 5-9c0-2.76-2.24-5-5-5zm0 7.5c-1.38 0-2.5-1.12-2.5-2.5S5.62 2.5 7 2.5 9.5 3.62 9.5 5 8.38 7.5 7 7.5z"/></svg>
          <div>
            <p class="cd-label">Dirección</p>
            <p class="cd-val">Paseo Santa María de la Cabeza, 10 · Madrid</p>
          </div>
        </div>
        <div class="cd-item">
          <svg width="14" height="14" viewBox="0 0 14 14" fill="var(--gold)" opacity="0.7"><path d="M11.45 9.07l-1.44-1.44a1.4 1.4 0 00-1.98 0l-.64.64a7.8 7.8 0 01-2.66-2.66l.64-.64a1.4 1.4 0 000-1.98L3.93.55A1.4 1.4 0 001.94.55L.69 1.8A2.8 2.8 0 00.06 3.95c.68 3.4 6.59 9.31 9.99 9.99a2.8 2.8 0 002.15-.63l1.25-1.25a1.4 1.4 0 00-.41-1.98l-1.59.99z"/></svg>
          <div>
            <p class="cd-label">Teléfono / WhatsApp</p>
            <p class="cd-val">+34 661 310 256</p>
          </div>
        </div>
        <div class="cd-item">
          <svg width="14" height="14" viewBox="0 0 14 14" fill="var(--gold)" opacity="0.7"><path d="M12.25 2.5h-10.5A1.75 1.75 0 000 4.25v5.5C0 10.21.79 11 1.75 11h10.5A1.75 1.75 0 0014 9.75v-5.5A1.75 1.75 0 0012.25 2.5zm-5.25 6L1.75 5.25l.98-.84L7 7.73l4.27-3.32.98.84L7 8.5z"/></svg>
          <div>
            <p class="cd-label">Email</p>
            <p class="cd-val">info@clinicaesmera.com</p>
          </div>
        </div>
        <div class="cd-item">
          <svg width="14" height="14" viewBox="0 0 14 14" fill="var(--gold)" opacity="0.7"><path d="M7 0C3.13 0 0 3.13 0 7s3.13 7 7 7 7-3.13 7-7-3.13-7-7-7zm.7 10.5H6.3V6.3h1.4v4.2zm0-5.6H6.3V3.5h1.4v1.4z"/></svg>
          <div>
            <p class="cd-label">Horario</p>
            <p class="cd-val">Lun – Sáb: 10:00 – 19:00</p>
          </div>
        </div>
      </div>
      <div class="cont-actions">
        <a href="https://wa.me/34661310256?text=Hola%2C%20me%20gustar%C3%ADa%20pedir%20informaci%C3%B3n" target="_blank" rel="noopener" class="btn btn-gold">Contactar por WhatsApp</a>
      </div>
    </div>
  </section>

  <Footer />
</Layout>

<style>
  /* Intro */
  .nos-section { padding: 72px 0; background: var(--ivory); }

  .nos-intro-text { max-width: 680px; }

  .nos-body {
    font-size: 1rem; color: var(--text-soft); line-height: 1.85;
    font-weight: 400; margin-bottom: 20px;
  }

  /* Valores */
  .valores-section { padding: 72px 0; background: var(--white); }

  .val-grid { display: grid; grid-template-columns: repeat(4,1fr); gap: 32px; margin-top: 48px; }

  .vc-num { font-family: var(--font-display); font-style: italic; font-size: 2rem; font-weight: 300; color: var(--gold); opacity: 0.5; line-height: 1; margin-bottom: 12px; }
  .vc-line { width: 24px; height: 1px; background: var(--gold); opacity: 0.3; margin-bottom: 14px; }
  .vc-title { font-family: var(--font-display); font-size: 1.05rem; font-weight: 500; color: var(--dark); margin-bottom: 10px; }
  .vc-desc { font-size: 0.85rem; color: var(--text-soft); line-height: 1.7; font-weight: 400; }

  /* Reseñas */
  .reviews-section { padding: 72px 0; background: var(--ivory); }

  .rev-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 24px; margin-top: 48px; }

  .rev-card {
    background: var(--white); border: 1px solid rgba(0,0,0,0.06);
    border-radius: var(--radius); padding: 32px 28px;
    display: flex; flex-direction: column; gap: 16px;
  }
  .rc-stars { color: var(--gold); font-size: 0.75rem; letter-spacing: 2px; }
  .rc-text { font-size: 0.88rem; color: var(--text-soft); line-height: 1.75; font-weight: 400; font-style: italic; flex: 1; }
  .rc-author { display: flex; align-items: center; gap: 12px; }
  .rca-avatar {
    width: 36px; height: 36px; background: var(--dark); border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    font-family: var(--font-display); font-style: italic; color: var(--gold); font-size: 0.9rem;
    flex-shrink: 0;
  }
  .rca-name { font-size: 0.85rem; font-weight: 500; color: var(--dark); margin-bottom: 2px; }
  .rca-tratamiento { font-size: 0.7rem; color: var(--text-muted); font-weight: 400; }

  /* Contacto */
  .contacto-section { padding: 72px 0; background: var(--white); }
  .cont-title { margin-bottom: 36px !important; }

  .cont-datos { display: flex; flex-direction: column; gap: 20px; max-width: 480px; margin-bottom: 40px; }
  .cd-item { display: flex; align-items: flex-start; gap: 12px; }
  .cd-item svg { flex-shrink: 0; margin-top: 2px; }
  .cd-label { font-size: 0.65rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--text-muted); margin-bottom: 3px; font-weight: 400; }
  .cd-val { font-size: 0.88rem; color: var(--text-soft); font-weight: 400; }

  .cont-actions { display: flex; gap: 14px; flex-wrap: wrap; }

  @media (max-width: 700px) {
    .nos-section, .valores-section, .reviews-section, .contacto-section { padding: 56px 0; }
    .val-grid { grid-template-columns: repeat(2,1fr); }
    .rev-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 480px) {
    .val-grid { grid-template-columns: 1fr; }
  }
</style>
