---
const ofertas = [
  { tratamiento: "Radiofrecuencia",  antes: "80",  ahora: "55",  zona: "Facial" },
  { tratamiento: "Láser CO2",        antes: "380", ahora: "290", zona: "Rostro completo" },
  { tratamiento: "Criolipólisis",    antes: "250", ahora: "190", zona: "Por zona" },
  { tratamiento: "Láser Depilatorio",antes: "120", ahora: "85",  zona: "Zona media" },
];
---

<section class="hero" id="inicio" aria-label="Portada">

  <div class="slide-bg" aria-hidden="true">
    <div class="bg-radial bg-r1"></div>
    <div class="bg-radial bg-r2"></div>
  </div>

  <div class="hero-wrap">
    <div class="s1-left">
      <h1 class="hero-title">
        <span class="s1-title-white">Ofertas </span><span class="s1-title-grad">exclusivas</span><br /><span class="s1-title-white">de este mes</span>
      </h1>
      <span class="eyebrow-line s1-line-bottom"></span>
      <p class="s1-sub">Promociones limitadas.<br />Reserva antes de que se agoten.</p>
      <a href="/bonos" class="btn btn-gold s1-cta">
        Ver Ofertas
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M2.5 7h9M8 3.5l3.5 3.5-3.5 3.5"/></svg>
      </a>
    </div>

    <div class="s1-center" aria-hidden="true"></div>

    <div class="s1-right">
      <div class="price-card">
        <div class="pc-header">
          <span class="pc-col pc-col-trat">Tratamiento</span>
          <span class="pc-col pc-col-before">Antes</span>
          <span class="pc-col pc-col-after">Ahora</span>
        </div>
        {ofertas.map(o => (
          <a href="/nosotros#contacto" class="pc-row">
            <div class="pcr-info">
              <span class="pcr-name">{o.tratamiento}</span>
              <span class="pcr-zona">{o.zona}</span>
            </div>
            <span class="pcr-before">€{o.antes}</span>
            <div class="pcr-after-wrap">
              <span class="pcr-after">€{o.ahora}</span>
              <span class="pcr-save">Reservar →</span>
            </div>
          </a>
        ))}
        <p class="pc-note">* Precios por sesión. Sujeto a disponibilidad.</p>
      </div>
    </div>
  </div>

  <div class="hero-scroll" aria-hidden="true">
    <span class="scroll-bar"></span>
  </div>

</section>

<style>
  .hero {
    min-height: 100vh;
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
    background-color: var(--ivory);
    background-image:
      linear-gradient(to right, rgba(0,0,0,0.55) 0%, rgba(0,0,0,0.28) 42%, transparent 68%),
      url('/Promociones del mes.png');
    background-size: cover;
    background-position: center;
  }

  .slide-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
    z-index: 1;
  }
  .bg-radial {
    position: absolute;
    border-radius: 50%;
    filter: blur(100px);
  }
  .bg-r1 { width: 600px; height: 600px; background: var(--gold); top: -200px; right: -100px; opacity: 0.05; }
  .bg-r2 { width: 400px; height: 400px; background: var(--gold-warm); bottom: -150px; left: 5%; opacity: 0.04; }

  .hero-wrap {
    max-width: 1180px;
    width: 100%;
    margin: 0 auto;
    padding: 96px 32px;
    padding-top: calc(96px + 72px);
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: 1fr 300px 440px;
    gap: 48px;
    align-items: center;
  }

  .hero-eyebrow {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 36px;
  }
  .eyebrow-line {
    display: block;
    width: 36px;
    height: 1px;
    background: #fff;
    opacity: 0.8;
  }

  .hero-title {
    font-family: var(--font-display);
    font-size: clamp(2.8rem, 4vw, 4.2rem);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.03em;
    margin-bottom: 16px;
  }

  .s1-title-white {
    color: #fff;
    text-shadow: 0 2px 16px rgba(0,0,0,0.45), 0 1px 4px rgba(0,0,0,0.3);
  }
  .s1-title-grad {
    color: #FFE066;
    text-shadow: 0 2px 16px rgba(0,0,0,0.45), 0 1px 4px rgba(0,0,0,0.3);
  }
  .s1-line-bottom {
    display: block;
    margin: 16px 0;
    background: #fff;
    opacity: 0.8;
  }

  .s1-left {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  .s1-sub {
    font-size: 1.15rem;
    color: #fff;
    text-shadow: 0 1px 8px rgba(0,0,0,0.4);
    font-weight: 400;
    margin-bottom: 36px;
    line-height: 1.7;
  }

  .s1-center { /* columna vacía — la foto del fondo se ve a través */ }

  .s1-right {
    display: flex;
    justify-content: flex-end;
  }
  .s1-right .price-card { width: 100%; }

  /* Price card */
  .price-card {
    background: #ffffff;
    border: 1px solid rgba(212, 175, 55, 0.25);
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: 0 4px 28px rgba(44, 44, 44, 0.12);
  }
  .pc-header {
    display: grid;
    grid-template-columns: 1fr 70px 90px;
    padding: 14px 20px;
    border-bottom: 1px solid rgba(212, 175, 55, 0.2);
    background: rgba(212, 175, 55, 0.09);
  }
  .pc-col {
    font-size: 0.62rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--text-muted);
    font-weight: 500;
  }
  .pc-col-before, .pc-col-after { text-align: right; }

  .pc-row {
    display: grid;
    grid-template-columns: 1fr 70px 90px;
    padding: 16px 20px;
    align-items: center;
    border-bottom: 1px solid rgba(44, 44, 44, 0.05);
    text-decoration: none;
    transition: background 0.2s;
    cursor: pointer;
  }
  .pc-row:last-of-type { border-bottom: none; }
  .pc-row:hover { background: rgba(212, 175, 55, 0.08); }

  .pcr-info { display: flex; flex-direction: column; gap: 3px; }
  .pcr-name { font-family: var(--font-display); font-size: 0.92rem; font-weight: 500; color: var(--dark); }
  .pcr-zona { font-size: 0.65rem; color: var(--text-muted); font-weight: 300; letter-spacing: 0.06em; }
  .pcr-before { font-size: 0.85rem; color: rgba(44, 44, 44, 0.35); text-decoration: line-through; text-align: right; font-weight: 300; }

  .pcr-after-wrap { display: flex; flex-direction: column; align-items: flex-end; gap: 2px; }
  .pcr-after { font-family: var(--font-display); font-size: 1.2rem; font-weight: 700; color: var(--gold-warm); line-height: 1; }
  .pcr-save { font-size: 0.6rem; letter-spacing: 0.1em; color: var(--gold-warm); text-transform: uppercase; opacity: 0; transition: opacity 0.2s; }
  .pc-row:hover .pcr-save { opacity: 0.8; }

  .pc-note { font-size: 0.65rem; color: var(--text-muted); padding: 10px 20px; font-weight: 300; border-top: 1px solid rgba(44, 44, 44, 0.05); }

  /* Scroll indicator */
  .hero-scroll {
    position: absolute;
    bottom: 40px;
    right: 40px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    z-index: 5;
  }
  .scroll-bar {
    display: block;
    width: 1px;
    height: 40px;
    background: linear-gradient(to bottom, transparent, rgba(212, 175, 55, 0.55));
    animation: scrollbar 2.5s infinite var(--ease);
  }
  @keyframes scrollbar {
    0%, 100% { opacity: 0.5; transform: scaleY(1); }
    50%       { opacity: 0.2; transform: scaleY(0.5); }
  }

  /* ─── RESPONSIVE: tablet ─── */
  @media (max-width: 960px) {
    .hero-wrap {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    .s1-center { display: none; }
    .hero-scroll { right: 20px; bottom: 32px; }
  }

  /* ─── RESPONSIVE: mobile ─── */
  @media (max-width: 640px) {
    .hero {
      min-height: 100vh;
      min-height: 100dvh;
    }
    .hero-wrap {
      padding: 80px 20px;
      padding-top: calc(80px + 72px);
      gap: 24px;
    }
    .hero-title { font-size: clamp(2rem, 8vw, 2.6rem); }
    .s1-sub { margin-bottom: 20px; font-size: 0.95rem; }
    .hero-eyebrow { margin-bottom: 20px; }
    .price-card { overflow: hidden; }
    .pc-note { display: none; }
    .hero-scroll { display: none; }
  }

  /* ─── RESPONSIVE: small phones ─── */
  @media (max-width: 480px) {
    .hero-wrap { padding: 72px 16px; padding-top: calc(72px + 72px); }
    .pc-header { display: none; }
    .pc-row { grid-template-columns: 1fr 80px; padding: 12px 14px; }
    .pcr-before { display: none; }
    .hero-title { font-size: clamp(1.9rem, 9vw, 2.3rem); }
    .s1-sub { font-size: 0.88rem; }
  }
</style>
